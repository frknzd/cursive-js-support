<idea-plugin>
    <id>com.cursivejssupport</id>
    <name>Cursive JS Support</name>
    <vendor url="https://github.com/frknzdmr">Furkan Ozdemir</vendor>

    <description><![CDATA[
        <p>
            First-class JavaScript interop tooling for ClojureScript development in Cursive.
            The plugin understands <code>js/</code> globals, property and method interop,
            constructors, threaded forms, npm modules, and Google Closure namespaces using
            bundled DOM and ECMAScript declarations plus the type definitions in your project.
        </p>
        <ul>
            <li>Type-aware completion, parameter information, quick documentation, and navigation</li>
            <li>Inspections and quick fixes for unknown globals, members, exports, arity, and deprecations</li>
            <li>npm package and workspace indexing with modern exports and subpath resolution</li>
            <li>Build discovery for shadow-cljs, cljs.main, and Figwheel Main</li>
            <li>Browser and Node.js debugging with ClojureScript source-map support</li>
        </ul>
        <p>
            Requires Cursive and IntelliJ IDEA Ultimate's JavaScript and JavaScript Debugger plugins.
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.cursiveclojure.cursive</depends>
    <depends>JavaScript</depends>
    <depends>JavaScriptDebugger</depends>

    <extensionPoints>
        <!-- Additional npm-export type providers can participate in the structured type pipeline. -->
        <extensionPoint
                qualifiedName="com.cursivejssupport.jsTypeSource"
                interface="com.cursivejssupport.types.JsTypeSource"
                dynamic="true"/>
        <extensionPoint
                qualifiedName="com.cursivejssupport.buildProfileAdapter"
                interface="com.cursivejssupport.project.CljsBuildProfileAdapter"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.cursivejssupport.settings.JsSupportSettings"/>
        <projectService
                serviceImplementation="com.cursivejssupport.npm.JsNpmDependencyWatcher"/>
        <projectService serviceImplementation="com.cursivejssupport.npm.IntellijNpmResolutionService"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.cursivejssupport.settings.JsSupportConfigurable"
                id="com.cursivejssupport.settings"
                displayName="Cursive JS Support"/>

        <notificationGroup id="Cursive JS Support" displayType="BALLOON" isLogByDefault="true"/>
        <postStartupActivity
                implementation="com.cursivejssupport.plugin.JsSupportPlugin"/>

        <daemon.highlightInfoFilter
                implementation="com.cursivejssupport.annotator.JsInteropHighlightFilter"/>

        <localInspection
                language="Clojure"
                shortName="ClojureJsInterop"
                displayName="ClojureScript JavaScript interop"
                groupName="ClojureScript"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.cursivejssupport.inspection.ClojureJsInteropInspection"/>

        <intentionAction>
            <language>Clojure</language>
            <className>com.cursivejssupport.inspection.AddJsTypeHintIntention</className>
            <category>ClojureScript</category>
            <descriptionDirectoryName>AddJsTypeHintIntention</descriptionDirectoryName>
        </intentionAction>
        <localInspection
                language="ClojureScript"
                shortName="ClojureScriptJsInterop"
                displayName="ClojureScript JavaScript interop"
                groupName="ClojureScript"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.cursivejssupport.inspection.JsInteropInspection"/>

        <typedHandler implementation="com.cursivejssupport.completion.InteropAutoPopupHandler"/>
        <consoleFilterProvider implementation="com.cursivejssupport.debug.CljsConsoleFilterProvider"/>
        <configurationType implementation="com.cursivejssupport.debug.CljsDebugConfigurationType"/>
        <toolWindow id="ClojureScript JS" anchor="bottom" factoryClass="com.cursivejssupport.project.CljsStatusToolWindowFactory"/>

        <completion.contributor
                order="first"
                language="Clojure"
                implementationClass="com.cursivejssupport.completion.InteropCompletionContributor"/>
        <completion.contributor
                order="first"
                language="ClojureScript"
                implementationClass="com.cursivejssupport.completion.InteropCompletionContributor"/>

        <completion.confidence
                order="first"
                language="Clojure"
                implementationClass="com.cursivejssupport.completion.JsInteropCompletionConfidence"/>
        <completion.confidence
                order="first"
                language="ClojureScript"
                implementationClass="com.cursivejssupport.completion.JsInteropCompletionConfidence"/>

        <lang.documentationProvider
                language="Clojure"
                implementationClass="com.cursivejssupport.completion.ClojureScriptDocumentationProvider"/>

        <lang.parameterInfo
                language="Clojure"
                implementationClass="com.cursivejssupport.completion.JsInteropParameterInfoHandler"/>
        <lang.parameterInfo
                language="ClojureScript"
                implementationClass="com.cursivejssupport.completion.JsInteropParameterInfoHandler"/>
        <lang.documentationProvider
                language="ClojureScript"
                implementationClass="com.cursivejssupport.completion.ClojureScriptDocumentationProvider"/>

        <psi.referenceContributor
                language="Clojure"
                implementation="com.cursivejssupport.reference.JsSymbolReferenceContributor"/>
        <psi.referenceContributor
                language="ClojureScript"
                implementation="com.cursivejssupport.reference.JsSymbolReferenceContributor"/>

        <gotoDeclarationHandler
                order="first"
                language="Clojure"
                implementation="com.cursivejssupport.reference.JsInteropGotoDeclarationHandler"/>
        <gotoDeclarationHandler
                order="first"
                language="ClojureScript"
                implementation="com.cursivejssupport.reference.JsInteropGotoDeclarationHandler"/>

    </extensions>

    <extensions defaultExtensionNs="com.cursivejssupport">
        <jsTypeSource implementation="com.cursivejssupport.npm.JsPluginTypeSource"/>
    </extensions>

    <extensions defaultExtensionNs="com.jetbrains">
        <javaScriptDebugAware implementation="com.cursivejssupport.debug.CljsJavaScriptDebugAware"/>
        <javaScriptDebugAware implementation="com.cursivejssupport.debug.CljcJavaScriptDebugAware"/>
    </extensions>
</idea-plugin>
